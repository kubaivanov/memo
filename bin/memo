#!/usr/bin/env python3
"""Memo: local memory for agents — a journal and a knowledge brief.

  memo memory init                create the journal in this folder
  memo memory wake [part [T]]     read the progressively compressed overview
  memo memory note "<line>"       append one short memory
  memo memory compress            show or settle the next summary block
  memo memory recall "<regex>"    search the journal; --fuzzy / --semantic
  memo memory show | amend | retract | expand | drop-summary
  memo memory index | status | tags

  memo knowledge wake [topics…]   brief a field from a vault of note cards
  memo knowledge recall "<regex>" search cards; --topic / --status / --fuzzy / --semantic
  memo knowledge show <name>       print one card
  memo knowledge index             build the optional semantic chunk index
"""

import argparse
from contextlib import contextmanager
from datetime import date, datetime, timedelta
from difflib import SequenceMatcher
import fcntl
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import unicodedata
import zlib


MAX_BYTES = 280
WAKE_ROWS = 32
PAGE_BYTES = 20_000
RAW_BLOCK = 16
KN_BRIEF = 5
MODEL = "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
TAGS = {"change", "decision", "blocker", "testing"}
REFERENCE = re.compile(r"^(Amends|Retracts) #(\d+)(?:-(\d+))?: ")


# --------------------------------------------------------------- shared

def root(cwd):
    for folder in (cwd, *cwd.parents):
        store = folder / ".memory"
        if store.exists() or store.is_symlink():
            if not store.is_dir() or store.is_symlink():
                raise ValueError(f"expected a real directory: {store}")
            return store
    return None


@contextmanager
def lock(store):
    with (store / ".lock").open("a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def atomic_json(path, value):
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                     dir=path.parent, delete=False) as handle:
        stage = Path(handle.name)
        try:
            json.dump(value, handle, ensure_ascii=False, separators=(",", ":"))
            handle.flush()
            os.fsync(handle.fileno())
            os.replace(stage, path)
        finally:
            stage.unlink(missing_ok=True)


def check(text):
    text = text.strip()
    if not text or len(text.splitlines()) != 1 or len(text.encode()) > MAX_BYTES:
        raise ValueError(f"expected one nonempty line of at most {MAX_BYTES} UTF-8 bytes")
    if any(unicodedata.category(c) == "Cc" for c in text):
        raise ValueError("control characters are not allowed")
    return text


def folded(text):
    return "".join(c for c in unicodedata.normalize("NFKD", text.casefold())
                   if not unicodedata.combining(c))


def embed(texts):
    if os.environ.get("MEMO_EMBED_STUB"):
        # Test hook: deterministic bag-of-bigrams vectors, no model weights.
        vectors = []
        for text in texts:
            vector = [0.0] * 64
            flat = folded(text)
            for i in range(len(flat) - 1):
                vector[zlib.crc32(flat[i:i + 2].encode()) % 64] = 1.0
            norm = sum(value * value for value in vector) ** 0.5 or 1.0
            vectors.append([value / norm for value in vector])
        return vectors
    try:
        from sentence_transformers import SentenceTransformer
    except ImportError:
        raise ValueError("semantic search requires: python3 -m pip install sentence-transformers")
    # Model weights may be downloaded on first use; text is encoded locally.
    return SentenceTransformer(MODEL).encode(texts, normalize_embeddings=True).tolist()


def cosine(query, vector):
    return math.fsum(a * b for a, b in zip(query, vector))


# --------------------------------------------------------------- journal

def read_entries(store):
    with (store / "entries.jsonl").open(encoding="utf-8") as handle:
        return [json.loads(line) for line in handle]


def append(store, entries, stamp, text):
    entry = {"id": len(entries), "date": stamp, "text": text}
    with (store / "entries.jsonl").open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    entries.append(entry)
    print(f"Saved as #{entry['id']}.")


def display(entry):
    return "#{id} {date} {text}".format(**entry)


def block_name(block):
    start, size = block
    return f"{start}-{start + size - 1}"


def block_id(value):
    match = re.fullmatch(r"#?(\d+)-#?(\d+)", value)
    if not match:
        raise ValueError("expected a block range such as 0-15")
    start, end = map(int, match.groups())
    size = end - start + 1
    if size < 2 or size & (size - 1) or start % size:
        raise ValueError("expected an aligned block of 2, 4, 8, … entries")
    return start, size


def halves(block):
    start, size = block
    step = size // 2
    return (start, step), (start + step, step)


def view(count):
    """Cover the prefix once, refining detail preferentially near the tail."""
    blocks = []
    start = 0
    while start < count:
        size = 1 << ((count - start).bit_length() - 1)
        blocks.append((start, size))
        start += size
    while len(blocks) < WAKE_ROWS:
        choices = [(size / (count - start), start, i)
                   for i, (start, size) in enumerate(blocks) if size > 1]
        if not choices:
            break
        _, _, index = max(choices)
        blocks[index:index + 1] = halves(blocks[index])
    return blocks


def summary_path(store, block):
    return store / "summaries" / f"{block_name(block)}.json"


def summary(store, block):
    path = summary_path(store, block)
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else None


def pending(store, count):
    def visit(block):
        if block[1] == 1 or summary(store, block) is not None:
            return
        if block[1] > RAW_BLOCK:
            for half in halves(block):
                yield from visit(half)
        yield block

    return [item for block in view(count) for item in visit(block)]


def request_summary(store, entries, jobs):
    if not jobs:
        return
    start, size = block = jobs[0]
    name = block_name(block)
    print(f"Compress #{name} into one line of at most {MAX_BYTES} UTF-8 bytes.")
    print("Keep what has lasting effect, drop what does not. Invent nothing.")
    if size <= RAW_BLOCK:
        for entry in entries[start:start + size]:
            print("  " + display(entry))
    else:
        for half in halves(block):
            print(f"  #{block_name(half)} {summary(store, half)}")
    print(f'Run: memo memory compress {name} "<your summary>"')


def wake(store, entries, args):
    count = len(entries) if args.snapshot is None else args.snapshot
    if not 0 <= count <= len(entries):
        raise ValueError("snapshot is outside the journal")
    jobs = pending(store, count)
    if jobs:
        print(f"Cannot wake: {len(jobs)} summary block(s) needed.")
        request_summary(store, entries, jobs)
        return 1
    pages, used = [[]], 0
    for start, size in view(count):
        block = (start, size)
        row = (display(entries[start]) if size == 1 else
               f"#{block_name(block)} {summary(store, block)}")
        width = len(row.encode()) + 1
        if pages[-1] and used + width > PAGE_BYTES:
            pages.append([])
            used = 0
        pages[-1].append(row)
        used += width
    if not 1 <= args.part <= len(pages):
        raise ValueError("no such page; run memo memory wake")
    if args.part == 1:
        print(f"Today is {date.today():%Y-%m-%d}.")
        if not count:
            print("No memories yet.")
    for row in pages[args.part - 1]:
        print(row)
    if args.part < len(pages):
        print(f"Not awake yet. Run: memo memory wake {args.part + 1} {count}")
    else:
        print("You are awake.")
    return 0


def references(entries, ranges):
    for entry in entries:
        match = REFERENCE.match(entry["text"])
        if match:
            lo = int(match[2])
            hi = int(match[3] or match[2])
            if any(max(lo, start) <= min(hi, end, entry["id"] - 1)
                   for start, end in ranges):
                yield entry


def when(value):
    if value == "today":
        return date.today().isoformat()
    if value == "yesterday":
        return (date.today() - timedelta(days=1)).isoformat()
    relative = re.fullmatch(r"(\d+)([hdw])", value)
    if relative:
        n, unit = relative.groups()
        return (datetime.now() - timedelta(
            hours=int(n) * {"h": 1, "d": 24, "w": 168}[unit])).isoformat(timespec="minutes")
    return value


def read_index(store):
    path = store / "index.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else None


def extend_index(store, entries):
    """Index the journal: build when missing, extend with new entries
    otherwise. Returns how many entries were embedded."""
    vectors = read_index(store) or []
    missing = entries[len(vectors):]
    if not missing:
        return 0
    vectors += embed([entry["text"] for entry in missing])
    atomic_json(store / "index.json", vectors)
    return len(missing)


def index_async():
    """Hand new-entry indexing to a short-lived background run of
    `memo memory index`; embedding there happens without holding the
    lock, so notes never wait for a model. A note must never fail
    because of this — if the child cannot spawn, the index catches up
    at the next `recall --semantic`."""
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "memory", "index"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def recall(store, entries, args):
    since, until = (when(v) if v else None for v in (args.since or args.on, args.until or args.on))
    candidates = [entry for entry in entries
                  if (not args.subject or entry["text"].casefold().startswith(
                      f"[{args.subject}] ".casefold()))
                  and (not since or entry["date"][:len(since)] >= since)
                  and (not until or entry["date"][:len(until)] <= until)]
    warning = None
    if args.semantic:
        vectors = read_index(store)
        missing = entries[len(vectors):] if vectors else entries
        if missing:
            vectors = (vectors or []) + embed([entry["text"] for entry in missing])
            atomic_json(store / "index.json", vectors)
            hint = "entries" if len(missing) > 1 else "entry"
            print(f"Indexed {len(missing)} {hint}; index current.")
        candidates = [entry for entry in candidates if entry["id"] < len(vectors)]
        if candidates:
            query = embed([args.query])[0]
            candidates.sort(key=lambda e: (
                cosine(query, vectors[e["id"]]), e["id"]), reverse=True)
    elif args.fuzzy:
        needle = folded(args.query)
        def score(entry):
            text = folded(entry["text"])
            if needle in text:
                return 1.0
            words = text.split()
            widths = max(1, len(needle.split()))
            return max((SequenceMatcher(None, needle, " ".join(words[i:i + widths])).ratio()
                        for i in range(len(words))), default=0)
        matches = [(score(entry), entry) for entry in candidates]
        candidates = [entry for value, entry in sorted(
            matches, key=lambda item: (item[0], item[1]["id"]), reverse=True)
            if value >= 0.6]
    else:
        pattern = re.compile(args.query, re.IGNORECASE)
        candidates = sorted((e for e in candidates if pattern.search(e["text"])),
                            key=lambda e: (e["date"], e["id"]), reverse=True)
    shown = candidates[:args.limit]
    for entry in shown:
        print(display(entry))
    print(f"{len(candidates)} matches." if candidates else "No match.")
    later = list(references(entries, [(e["id"], e["id"]) for e in shown]))
    if later:
        print("Later corrections / retractions:")
        for entry in later[-8:]:
            print("  " + display(entry))
    if warning:
        print(warning)


def available_tags(store):
    path = store / "tags.json"
    return TAGS | (set(json.loads(path.read_text(encoding="utf-8"))) if path.exists() else set())


def journal_run(args):
    cwd = Path.cwd().resolve()
    store = root(cwd)
    cmd = args.command
    if cmd == "init":
        if store is not None and store.parent != cwd:
            raise ValueError(f"this folder already belongs to {store.parent}")
        store = cwd / ".memory"
        store.mkdir(mode=0o700, exist_ok=True)
        with lock(store):
            if (store / "entries.txt").exists() or (store / "LOG.txt").exists():
                raise ValueError("legacy journal found; use a new folder until it can be migrated")
            (store / "summaries").mkdir(exist_ok=True)
            (store / "entries.jsonl").touch(exist_ok=True)
        print(f"Journal: {store}")
        return 0
    if store is None:
        raise ValueError("no journal here; run memo memory init in the agent folder")
    # All reads and writes use a consistent journal snapshot. Index inference
    # releases the lock so it cannot hold up ordinary writes.
    with lock(store):
        entries = read_entries(store)
        if cmd != "index":
            return journal_operate(store, entries, args)
        vectors = [] if args.rebuild else (read_index(store) or [])
    if args.status:
        print(f"Indexed {len(vectors)}/{len(entries)} entries.")
        return 0
    missing = entries[len(vectors):]
    if missing:
        vectors += embed([e["text"] for e in missing])
        with lock(store):
            current = read_index(store) or []
            if len(vectors) >= len(current):
                atomic_json(store / "index.json", vectors)
            else:
                vectors = current
    print(f"Indexed {len(vectors)}/{len(entries)} entries (start-of-command snapshot).")
    return 0


def journal_operate(store, entries, args):
    cmd = args.command
    if cmd == "wake":
        return wake(store, entries, args)
    if cmd == "note":
        tag = args.tag.casefold() if args.tag else None
        if tag and tag not in available_tags(store) and not args.force:
            raise ValueError(f"unknown tag: {tag}; see memo memory tags")
        subject = f"[{args.subject}] " if args.subject else ""
        stamp = args.date or date.today().isoformat()
        datetime.fromisoformat(stamp)
        text = check(subject + (f"{tag}: " if tag else "") + check(args.text))
        for entry in reversed(entries):
            if not args.force and entry["text"] == text and (
                    not args.date or entry["date"] == stamp):
                print(f"Already recorded as #{entry['id']}. Use --force to record it again.")
                return 0
        append(store, entries, stamp, text)
        request_summary(store, entries, pending(store, len(entries)))
        if os.environ.get("MEMO_SYNC_INDEX"):
            try:
                fresh = extend_index(store, entries)
                if fresh:
                    print(f"Indexed {fresh} new; index current.")
            except ValueError:
                if read_index(store) is not None:
                    print("Index not refreshed: semantic deps missing.")
        else:
            index_async()
    elif cmd == "compress":
        jobs = pending(store, len(entries))
        if args.range is not None or args.text is not None:
            if not args.range or not args.text:
                raise ValueError('expected: memo memory compress <range> "<summary>"')
            target = block_id(args.range)
            if summary(store, target) is not None:
                print(f"#{block_name(target)} is already summarized.")
            elif not jobs or target != jobs[0]:
                raise ValueError("not the next pending block; run memo memory compress")
            else:
                atomic_json(summary_path(store, target), check(args.text))
                print(f"#{block_name(target)} saved.")
            jobs = pending(store, len(entries))
        if jobs:
            request_summary(store, entries, jobs)
        else:
            print("Nothing left to compress.")
    elif cmd == "recall":
        if args.limit < 1 or ((args.semantic or args.fuzzy) and not args.query):
            raise ValueError("use a positive result limit and a nonempty fuzzy/semantic query")
        recall(store, entries, args)
    elif cmd == "status":
        print(f"Journal: {store}\nEntries: {len(entries)}")
        print(f"Pending summaries: {len(pending(store, len(entries)))}")
        print(f"Indexed: {len(read_index(store) or [])}/{len(entries)}")
    elif cmd == "tags":
        tags = available_tags(store)
        if args.add:
            name = args.add.split(":", 1)[0].strip().casefold()
            if not re.fullmatch(r"[a-z][a-z0-9_-]*", name):
                raise ValueError("tags must start with a lowercase letter")
            tags.add(name)
            atomic_json(store / "tags.json", sorted(tags - TAGS))
        print("\n".join(sorted(tags)))
    else:
        if "-" in args.target:
            start, size = block_id(args.target)
        else:
            start, size = int(args.target.lstrip("#")), 1
        end = start + size - 1
        if not 0 <= start <= end < len(entries):
            raise ValueError("target is outside the journal")
        name = str(start) if size == 1 else block_name((start, size))
        if cmd == "show":
            print(display(entries[start]) if size == 1 else
                  f"#{name} {summary(store, (start, size)) or '(not summarized)'}")
            for entry in references(entries, [(start, end)]):
                print("  " + display(entry))
        elif cmd in ("amend", "retract"):
            verb = "Amends" if cmd == "amend" else "Retracts"
            append(store, entries, date.today().isoformat(), check(f"{verb} #{name}: {args.text}"))
            request_summary(store, entries, pending(store, len(entries)))
        elif size == 1:
            raise ValueError("expected a block range")
        elif cmd == "expand":
            for half in halves((start, size)):
                text = summary(store, half) if half[1] > 1 else None
                if text:
                    print(f"#{block_name(half)} {text}")
                else:
                    for entry in entries[half[0]:half[0] + half[1]]:
                        print(display(entry))
        elif cmd == "drop-summary":
            for path in (store / "summaries").glob("*.json"):
                lo, length = block_id(path.stem)
                if lo <= start and end < lo + length:
                    path.unlink()
            print(f"Dropped #{name} and enclosing summaries; entries unchanged.")
    return 0


# --------------------------------------------------------------- knowledge

def vault_locate(explicit=None):
    """The vault is chosen, never guessed, in this order: --dir,
    KNOWLEDGE_DIR, then knowledge_dir in the config file."""
    for origin, value in (("--dir", explicit),
                          ("KNOWLEDGE_DIR", os.environ.get("KNOWLEDGE_DIR"))):
        if value:
            return vault_check(Path(value).expanduser().resolve(), origin)
    config = Path(os.environ.get("MEMO_CONFIG")
                  or Path.home() / ".config" / "memo" / "config.json")
    if config.is_file():
        try:
            chosen = json.loads(config.read_text(encoding="utf-8")).get("knowledge_dir")
        except json.JSONDecodeError as error:
            raise ValueError(f"bad config {config}: {error}")
        if chosen:
            return vault_check(Path(chosen).expanduser().resolve(), str(config))
    raise ValueError("no knowledge vault selected; pass --dir, set KNOWLEDGE_DIR, "
                     f"or set knowledge_dir in {config}")


def vault_check(vault, origin):
    if not (vault / "sources").is_dir() or not (vault / "topics").is_dir():
        raise ValueError(f"not a knowledge vault (needs sources/ and topics/), "
                         f"via {origin}: {vault}")
    return vault


def parse_note(text):
    match = re.match(r"^---\n(.*?)\n---\n?(.*)\Z", text, re.S)
    if not match:
        return {}, text
    meta = {}
    for line in match.group(1).split("\n"):
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if m:
            meta[m.group(1)] = m.group(2).strip()
    return meta, match.group(2)


def meta_topics(meta):
    raw = (meta.get("topics") or "").strip()
    if raw.startswith("[") and raw.endswith("]"):
        raw = raw[1:-1]
    return [t.strip().strip('"').strip("[]") for t in raw.split(",") if t.strip()]


def load_cards(vault):
    cards = []
    for path in sorted((vault / "sources").glob("*.md")):
        meta, body = parse_note(path.read_text(encoding="utf-8"))
        cards.append({
            "name": path.stem,
            "title": meta.get("title", "").strip('"') or path.stem,
            "status": (meta.get("status") or "new").strip('"'),
            "captured": (meta.get("captured") or meta.get("published") or "").strip('"'),
            "topics": meta_topics(meta),
            "meta": meta,
            "body": body,
        })
    return cards


def kn_filter(cards, args):
    if getattr(args, "topic", None):
        want = {t.strip().strip('"[] ') for t in args.topic}
        cards = [c for c in cards if want & set(c["topics"])]
    if getattr(args, "status", None):
        cards = [c for c in cards if c["status"] == args.status]
    return cards


def kn_wake(vault, args):
    topics = [t.strip().strip('"[] ') for t in args.topics]
    cards = load_cards(vault)
    pool = [c for c in cards if not topics or set(c["topics"]) & set(topics)]
    stamps = {}
    for folder, label in (("inbox", "in inbox"), ("ideas", "ideas"), ("sources", "sources")):
        stamps[label] = len(list((vault / folder).glob("*"))) if (vault / folder).is_dir() else 0
    field = ", ".join(topics) if topics else "whole vault"
    print(f"Knowledge: {vault}")
    print(f"{stamps['sources']} sources, {stamps['ideas']} ideas, {stamps['in inbox']} in inbox. "
          f"Field: {field} — {len(pool)} source(s) match.")
    used = sum(1 for c in pool if c["status"] == "used")
    for status, cap, label in (("new", KN_BRIEF, "Fresh"), ("read", 3, "Ready to use")):
        bucket = sorted((c for c in pool if c["status"] == status),
                        key=lambda c: (c["captured"], c["name"]), reverse=True)
        print(f"{label} ({status}): {len(bucket)}")
        for card in bucket[:cap]:
            tags = ", ".join(card["topics"]) or "no topics"
            print(f"- {card['name']} ({card['captured']}) [{tags}]")
    if used:
        print(f"Used in outputs: {used}")
    routers = [t for t in topics if (vault / "topics" / f"{t}.md").exists()]
    if routers:
        print("Routers: " + ", ".join(f"topics/{t}.md" for t in routers))
    print("You are briefed.")
    print('Recall with: memo knowledge recall "<query>" [--topic <tag>] [--status <s>]')
    return 0


def kn_chunks(card):
    """Embedding window is short: chunk a card into heading-sized parts,
    each carrying the title, so a hit points at the part that matched."""
    chunks = []
    seen = set()
    for para in re.split(r"\n(?=#)|\n\s*\n", card["body"]):
        text = " ".join(para.split())
        if not text:
            continue
        chunk = f"{card['title']}\n{text}"
        if chunk not in seen:
            seen.add(chunk)
            chunks.append({"card": card["name"], "text": chunk})
    return chunks


def kn_index_path(vault):
    return vault / ".knowledge" / "index.json"


def kn_index_read(vault):
    path = kn_index_path(vault)
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else None


def kn_recall(vault, args):
    if args.limit < 1 or ((args.semantic or args.fuzzy) and not args.query):
        raise ValueError("use a positive result limit and a nonempty fuzzy/semantic query")
    cards = kn_filter(load_cards(vault), args)
    if args.semantic:
        index, embedded = kn_refresh(vault)
        if embedded:
            print(f"Indexed {embedded} chunk{'s' if embedded != 1 else ''}; index current.")
        names = {card["name"] for card in cards}
        query = embed([args.query])[0]
        scored = sorted(((cosine(query, vector), chunk) for vector, chunk
                         in zip(index["vectors"], index["chunks"])
                         if chunk["card"] in names),
                        key=lambda item: (-item[0], item[1]["card"]))
        best, seen = [], set()
        for score, chunk in scored:
            if chunk["card"] not in seen:
                seen.add(chunk["card"])
                best.append((score, chunk))
            if len(best) >= args.limit:
                break
        by_name = {card["name"]: card for card in cards}
        for score, chunk in best:
            card = by_name[chunk["card"]]
            tags = ", ".join(card["topics"]) or "no topics"
            print(f"{card['name']} ({card['status']}, {card['captured']}) "
                  f"[{tags}] -- {score:.2f}")
            print("  " + " ".join(chunk["text"].split("\n", 1)[1].split())[:160])
        print(f"{len(seen)} card(s), ranked by meaning." if seen else "No card.")
    else:
        if args.fuzzy:
            needle = folded(args.query)
            def score(card):
                text = folded(card["body"] + " " + card["title"] + " " + card["name"])
                if needle in text:
                    return 1.0
                words = text.split()
                widths = max(1, len(needle.split()))
                return max((SequenceMatcher(None, needle, " ".join(words[i:i + widths])).ratio()
                            for i in range(len(words))), default=0)
            matches = [(score(card), card) for card in cards]
            cards = [card for value, card in sorted(
                matches, key=lambda item: (item[0], item[1]["name"]), reverse=True)
                if value >= 0.6]
        elif args.query:
            pattern = re.compile(args.query, re.IGNORECASE)
            cards = [c for c in cards if pattern.search(
                f"{c['name']} {c['title']} {c['body']}")]
        cards.sort(key=lambda c: (c["captured"], c["name"]), reverse=True)
        shown = cards[:args.limit]
        for card in shown:
            tags = ", ".join(card["topics"]) or "no topics"
            print(f"{card['name']} ({card['status']}, {card['captured']}) "
                  f"[{tags}] {card['title']}")
        print(f"{len(cards)} card(s)." if cards else "No card.")
    return 0


def kn_show(vault, args):
    target = args.file.strip().removesuffix(".md")
    hits = []
    for folder in ("sources", "ideas"):
        path = vault / folder / f"{target}.md"
        if path.exists():
            hits.append(path)
    if not hits:
        for folder in ("sources", "ideas"):
            for path in (vault / folder).glob("*.md"):
                if target in path.stem:
                    hits.append(path)
        if len(hits) != 1:
            raise ValueError("no unique card: " + args.file)
    path = hits[0]
    meta, body = parse_note(path.read_text(encoding="utf-8"))
    print(f"{path.stem} [{', '.join(meta_topics(meta)) or 'no topics'}] "
          f"status: {(meta.get('status') or 'new').strip(chr(34))}")
    for key in ("author", "url", "published", "captured", "rating"):
        if meta.get(key):
            print(f"{key}: {meta[key].strip(chr(34))}")
    print()
    print(body.strip())
    return 0


def kn_refresh(vault, rebuild=False):
    """Ensure the chunk index covers every card; returns (index, embedded)."""
    cards = load_cards(vault)
    old = None if rebuild else kn_index_read(vault)
    done = {chunk["card"] for chunk in old["chunks"]} if old else set()
    fresh = [chunk for card in cards if card["name"] not in done
             for chunk in kn_chunks(card)]
    if old and not fresh:
        return old, 0
    vectors = embed([chunk["text"] for chunk in fresh])
    index = {
        "cards": len(cards),
        "chunks": (old["chunks"] if old else []) + fresh,
        "vectors": (old["vectors"] if old else []) + vectors,
    }
    (vault / ".knowledge").mkdir(exist_ok=True)
    atomic_json(kn_index_path(vault), index)
    return index, len(fresh)


def kn_index(vault, args):
    if args.status:
        index = kn_index_read(vault)
        if index:
            print(f"Indexed {index['cards']} cards, {len(index['chunks'])} chunks.")
        else:
            print("No semantic index. Run: memo knowledge index")
        return 0
    index, _ = kn_refresh(vault, rebuild=args.rebuild)
    print(f"Indexed {index['cards']} cards, {len(index['chunks'])} chunks "
          f"(start-of-command snapshot).")
    return 0


def knowledge_run(args):
    vault = vault_locate(args.dir)
    if args.command == "wake":
        return kn_wake(vault, args)
    if args.command == "recall":
        return kn_recall(vault, args)
    if args.command == "show":
        return kn_show(vault, args)
    return kn_index(vault, args)


# --------------------------------------------------------------- cli

def parser():
    cli = argparse.ArgumentParser(description=__doc__)
    groups = cli.add_subparsers(dest="group", required=True)

    memory = groups.add_parser("memory", help="the agent's journal")
    commands = memory.add_subparsers(dest="command", required=True)
    commands.add_parser("init", help="create a local journal")
    p = commands.add_parser("wake", help="read the progressively compressed overview")
    p.add_argument("part", nargs="?", type=int, default=1)
    p.add_argument("snapshot", nargs="?", type=int)
    p = commands.add_parser("note", help="append a short memory")
    p.add_argument("text")
    p.add_argument("--subject")
    p.add_argument("--tag")
    p.add_argument("--date")
    p.add_argument("--force", action="store_true")
    p = commands.add_parser("compress", help="show or settle the next summary")
    p.add_argument("range", nargs="?")
    p.add_argument("text", nargs="?")

    p = commands.add_parser("recall", help="search original entries")
    p.add_argument("query", nargs="?", default="")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("--subject")
    p.add_argument("--since")
    p.add_argument("--until")
    p.add_argument("--on")
    modes = p.add_mutually_exclusive_group()
    modes.add_argument("--semantic", action="store_true")
    modes.add_argument("--fuzzy", action="store_true")
    for name in ("show", "amend", "retract", "expand", "drop-summary"):
        p = commands.add_parser(name)
        p.add_argument("target")
        if name in ("amend", "retract"):
            p.add_argument("text")
    p = commands.add_parser("index", help="update the optional semantic index")
    modes = p.add_mutually_exclusive_group()
    modes.add_argument("--status", action="store_true")
    modes.add_argument("--rebuild", action="store_true")
    commands.add_parser("status")
    p = commands.add_parser("tags")
    p.add_argument("--add")

    knowledge = groups.add_parser("knowledge", help="brief and search a vault of note cards")
    kcmd = knowledge.add_subparsers(dest="command", required=True)
    p = kcmd.add_parser("wake", help="one brief of the field, from vault frontmatter")
    p.add_argument("topics", nargs="*")
    p.add_argument("--dir")
    p = kcmd.add_parser("recall", help="search source cards; regex by default")
    p.add_argument("query", nargs="?", default="")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("--topic", action="append", help="filter by topic (repeatable)")
    p.add_argument("--status", help="filter by status: new, read, used")
    modes = p.add_mutually_exclusive_group()
    modes.add_argument("--semantic", action="store_true")
    modes.add_argument("--fuzzy", action="store_true")
    p.add_argument("--dir")
    p = kcmd.add_parser("show", help="print one card")
    p.add_argument("file")
    p.add_argument("--dir")
    p = kcmd.add_parser("index", help="build or refresh the optional semantic index")
    modes = p.add_mutually_exclusive_group()
    modes.add_argument("--status", action="store_true")
    modes.add_argument("--rebuild", action="store_true")
    p.add_argument("--dir")
    return cli


def run(args):
    if args.group == "knowledge":
        return knowledge_run(args)
    return journal_run(args)


if __name__ == "__main__":
    try:
        sys.exit(run(parser().parse_args()))
    except (OSError, ValueError, re.error) as error:
        print(f"memo: {error}", file=sys.stderr)
        sys.exit(1)
